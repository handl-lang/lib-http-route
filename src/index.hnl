--- http-route -- pure routing layer between `serve` (lib-serve /
--- serve-epoll) and Handl handler arrows.
---
--- `serve` hands the handler a parsed request record
--- `{ method, target, path, query, version, headers, body, body_bytes }`
--- (lib-http-rfc shape) and expects a response record back
--- `{ status?, headers?, body? | body_bytes? }`. This module is the
--- dispatch half: given route entries it picks the most *specific*
--- method+path match, binds `:param` segments, `*name` wildcard
--- remainders and the parsed query string onto the request, and calls
--- the handler.
---
--- Route entries (legacy list form, still supported):
---   { method?: String | "*",   -- absent or "*" matches any method
---     path:   String,          -- "/users/:id", "/files/*rest", "*"
---     handler: (req) ~> resp } -- plain arrow, same shape as serve's
---
--- Path patterns are segment-wise (`str.split` on "/"):
---   - literal segments must match exactly;
---   - `:name` binds one segment into `req.params.name` (string, may be
---     empty for a trailing slash);
---   - `*` or `*name` as the LAST segment matches any remaining
---     segments; `*name` binds the remainder ("/"-joined) to
---     `req.params.name`, bare `*` binds nothing; a `*`/` *name`
---     segment anywhere else makes the pattern never match;
---   - segment counts must agree otherwise ("/a/b" does not match "/a"
---     or "/a/b/c"); matching is case-sensitive and "/"-exact, so
---     "/users/" and "/users" are different paths.
---
--- v3 pattern grammar (compiled once per route at `router()` build;
--- patterns without the new productions keep the v2 matcher):
---   - `(/seg)` optional group, e.g. `/files(/:name)` matches "/files"
---     and "/files/x"; groups may nest `(/a(/b))` up to depth 4 and a
---     pattern may hold at most 8 groups total (compile error beyond);
---   - suffix/prefix vars inside a segment: `:file.:ext` binds
---     `{file, ext}` (greedy: the param takes up to the LAST literal
---     anchor), `v:version` binds `version` after literal "v"; param
---     names are `[A-Za-z0-9_-]` and adjacent params need a literal
---     separator;
---   - `?foo=bar&baz` search constraints on the pattern (or a
---     `constraints` record on a spec/method-map leaf): the route only
---     matches when the request's parsed query satisfies every
---     `key=value` pair (bare `key` requires presence). Constraints
---     are part of path-match eligibility: a constraint miss is a 404,
---     not a 405.
---   - `(` only opens a group when followed by `/` or `)`, `)` only
---     closes an open group, `*` is a splat only at a segment start --
---     otherwise they stay literal, so v1/v2 patterns keep working.
---   - malformed patterns (unbalanced parens, params without names,
---     groups not followed by `/` or end) raise at compile time.
---
--- On a match the handler receives `req` merged with:
---   params        -- record of `:name`/`*name` bindings ({} when none)
---   query_params  -- record parsed from `req.query` by `query/1`
---
--- Dispatch is specificity-ranked, not first-match: among entries whose
--- path pattern matches, only method-compatible ones are eligible, and
--- the winner is the highest-scoring pattern (static segment = 2,
--- `:param` = 1, `*`/` *name` = 0, compared left-to-right; a pattern
--- that is a strict score-prefix of another wins -- an exact "/a/b"
--- beats "/a/b/*"). Equal scores keep list order. Path matches with no
--- method-compatible entry produce a 405 (`Allow` header = the
--- comma-joined methods of the path-matching entries); no path match
--- at all produces `not_found` ({ status: 404, ... }).
---
--- Named route maps (v2, remix-inspired) -- `route/1` builds a
--- route-map record `{ entries, by_name }` from a record
--- `{ name: leaf | nested }`:
---   - leaf = handler arrow            -> any method ("*"), path derived
---                                        from the key path;
---   - leaf = { get: h, post: h, ... }  -> method map: one entry per
---                                        method key (case-insensitive,
---     stored uppercased) at the same derived/explicit path. A method
---     map must be *pure*: only HTTP-method keys plus the config keys
---     `path`, `pattern`, `method`, `methods` are allowed; anything
---     else makes the record a nested map instead. Method names are
---     therefore reserved keys inside route maps.
---   - leaf = { method?, methods?, path?, pattern?, handler,
---              constraints? } ->
---     explicit spec; `method`/`methods` accept a string or list
---     (uppercased), absent means "*"; `path`/`pattern` override the
---     derived path (a missing leading "/" is added); `constraints`
---     is a `{key: value}` record (or list of `{k,v}`/`[k,v]` pairs)
---     of required query params, merged with any `?k=v` suffix on the
---     pattern itself.
---   - a nested record recurses: keys join with "/" into the path.
---     The key "." (or "") contributes no segment -- `{ ".": h }` is the
---     index/root route (path "/", name "index").
---   - top-level `{ get: h, post: h }` is a method map at path "/".
---
--- Entry `name` = the key path joined by "/" ("index" for root) and is
--- what `by_name`/`href/3` look up; `path` is the match pattern.
---
--- `href/2` generates URLs by substituting `:var` and `*name`
--- segments from a params record: `href("/users/:id", {id:"42"})` ->
--- "/users/42". A missing param raises via `error.raise` (raw
--- substitution -- callers percent-encode values themselves; extra
--- params are ignored). `href/3` = `href(map, name, params)` looks the
--- name up in a route-map's `by_name`. For v3 patterns `href` emits
--- the same grammar: optional groups are omitted when any param they
--- reference is absent, suffix vars are joined with their literals,
--- and search constraints are appended as `?k=v&...`. `form(pattern)`
--- is the remix GET+POST convention: `form("/login")` returns a
--- builder `(handlers) ~> leaf-record` (also callable as
--- `form(pattern, hs)`) producing `{ path: pattern, ...handlers }` --
--- a method-map leaf pairing `get`/`post` at one URL.
---
--- `resources(name, handlers, opts?)` / `resource(name, handlers,
--- opts?)` (v3, P-006) build REST route-map fragments -- records of
--- `{ methods, path, handler }` spec leaves keyed by action
--- (`index`/`show`/`new`/`create`/`edit`/`update`/`destroy`; singular
--- `resource` emits only `show`/`create`/`update`/`destroy` with no
--- `:param` segment). `update` emits PUT+PATCH by default;
--- `opts.methods.<action>` pins the verb(s). Options: `only`/`except`
--- (action lists), `param` (default `"id"`), `path` (mount prefix,
--- default `"/" + name`), `methods` (per-action override). Handlers
--- may be a single arrow (all actions) or a record `{action: arrow}`.
--- The fragment nests into route maps:
--- `route({ photos: resources("photos", hs) })`.
---
--- Exports:
---   match_path(pattern, path)  ~> params record | null
---   query(qs)                  ~> query-string -> record
---   json_body(req)             ~> parsed JSON body | null
---   not_found                  -- the default 404 response record
---   route(x, ...)              ~> route-map record (arity 1: map|list)
---                               | resp record  (arity 2: routes, req)
---   router(routes)             ~> (req) ~> resp   -- serve-ready
---   href(a, ...)               ~> URL string  -- (pattern|entry, params)
---                               | (map, name, params)
---   form(pattern, handlers?)  ~> leaf builder | leaf record
---   resources(name, hs, opts?) ~> REST route-map fragment (plural)
---   resource(name, hs, opts?)  ~> REST route-map fragment (singular)

from "str" import * as str
from "char" import * as char
from "typeof" import * as typeof
from "json" import * as json

-- ---------------------------------------------------------------------
-- list / record helpers
-- ---------------------------------------------------------------------

alen := (xs) ~> while { xs: xs, n: 0 } {
  (xs, n) ~> match xs {
    []: { out: n },
    [_h, ...t]: { state: { xs: t, n: n + 1 } }
  }
}

lmap := (f, xs) ~> while { xs: xs, out: [] } {
  (xs, out) ~> match xs {
    []: { out: out },
    [h, ...t]: { state: { xs: t, out: [...out, f(h)] } }
  }
}

lfilter := (f, xs) ~> while { xs: xs, out: [] } {
  (xs, out) ~> match xs {
    []: { out: out },
    [h, ...t]: if f(h) {
      { state: { xs: t, out: [...out, h] } }
    } else {
      { state: { xs: t, out: out } }
    }
  }
}

--- append every element of `bs` onto `a`, preserving order.
cat := (a, bs) ~> while { xs: bs, out: a } {
  (xs, out) ~> match xs {
    []: { out: out },
    [h, ...t]: { state: { xs: t, out: [...out, h] } }
  }
}

mem := (x, xs) ~> while { xs: xs, found: false } {
  (xs, found) ~> match xs {
    []: { out: found },
    [h, ...t]: if h == x {
      { out: true }
    } else {
      { state: { xs: t, found: found } }
    }
  }
}

is_arr    := (v) ~> type.of(v) == "array"
is_obj    := (v) ~> type.of(v) == "object"
is_str    := (v) ~> type.of(v) == "string"
is_arrow  := (v) ~> type.of(v) == "arrow"

str_of := (v) ~> if is_str(v) { v } else { type.to_string(v) }

-- ---------------------------------------------------------------------
-- path patterns
-- ---------------------------------------------------------------------

--- segment-wise match of `pattern` against `path`. Returns the params
--- record on match, null on mismatch. A trailing `*`/`*name` segment
--- consumes the rest of the path; `*name` binds the "/"-joined remainder
--- to `name`, bare `*` binds nothing. `*` anywhere but last never matches.
match_segs := (ps, ss, params) ~> while { ps: ps, ss: ss, params: params } {
  (ps, ss, params) ~> match ps {
    []: { out: if alen(ss) == 0 { params } else { null } },
    [p, ...pt]: if str.starts_with(p, "*") {
      if alen(pt) == 0 {
        if p == "*" {
          { out: params }
        } else {
          { out: hash_map.set(params,
            str.slice(p, 1, str.length(p)), str.join(ss, "/")) }
        }
      } else {
        { out: null }
      }
    } else {
      match ss {
        []: { out: null },
        [s, ...st]: if str.starts_with(p, ":") {
          { state: { ps: pt, ss: st,
            params: hash_map.set(params,
              str.slice(p, 1, str.length(p)), s) } }
        } else {
          if p == s {
            { state: { ps: pt, ss: st, params: params } }
          } else {
            { out: null }
          }
        }
      }
    }
  }
}

-- (the v3 pattern compiler + `match_path` live after the query
-- section, since constraint parsing reuses `pct_decode`).

-- ---------------------------------------------------------------------
-- specificity scoring
-- ---------------------------------------------------------------------

--- per-segment score: literal 2 > `:param` 1 > `*`/` *name` 0.
seg_score := (p) ~> if str.starts_with(p, "*") {
  0
} else {
  if str.starts_with(p, ":") { 1 } else { 2 }
}

pat_score := (pattern) ~> lmap(seg_score, str.split(pattern, "/"))

--- true when score list `a` is strictly more specific than `b`:
--- lexicographic left-to-right, higher segment score wins; a strict
--- score-prefix wins (exact "/a/b" [2,2] beats "/a/b/*" [2,2,0]); fully
--- equal scores are a tie (dispatch keeps list order).
score_better := (a, b) ~> while { xs: a, ys: b } {
  (xs, ys) ~> match xs {
    []: { out: alen(ys) > 0 },
    [x, ...xt]: match ys {
      []: { out: false },
      [y, ...yt]: if x == y {
        { state: { xs: xt, ys: yt } }
      } else {
        { out: x > y }
      }
    }
  }
}

-- ---------------------------------------------------------------------
-- query strings
-- ---------------------------------------------------------------------

--- hex digit value, -1 when not a hex char (mirrors http_rfc).
hexval := (c) ~> do {
  if c >= 48 && c <= 57 {
    c - 48
  } else {
    if c >= 65 && c <= 70 {
      c - 55
    } else {
      if c >= 97 && c <= 102 {
        c - 87
      } else {
        -1
      }
    }
  }
}

--- percent-decode `s`: `%XX` -> byte as a char, `+` -> space, invalid
--- `%` sequences pass through literally.
pct_decode := (s) ~> while { i: 0, n: str.length(s), acc: "" } {
  (i, n, acc) ~> if i >= n {
    { out: acc }
  } else {
    do {
      c := str.char_at(s, i)
      if c == "%" && i + 2 < n {
        do {
          h1 := hexval(char.code_point_at(s, i + 1))
          h2 := hexval(char.code_point_at(s, i + 2))
          if h1 >= 0 && h2 >= 0 {
            { state: { i: i + 3, n: n,
              acc: acc + char.from_code_point(h1 * 16 + h2) } }
          } else {
            { state: { i: i + 1, n: n, acc: acc + c } }
          }
        }
      } else {
        { state: { i: i + 1, n: n,
          acc: acc + if c == "+" { " " } else { c } } }
      }
    }
  }
}

--- insert `v` under `k`: repeated keys accumulate into a list
--- ("a=1&a=2" -> { a: ["1", "2"] }).
qput := (acc, k, v) ~> do {
  if hash_map.has(acc, k) {
    do {
      old := hash_map.get_or(acc, k, null)
      nv := if typeof.is(old, typeof.arr()) {
        [...old, v]
      } else {
        [old, v]
      }
      hash_map.set(acc, k, nv)
    }
  } else {
    hash_map.set(acc, k, v)
  }
}

--- parse `qs` (the part after `?`, no leading `?`) into a record of
--- string values. Bare `flag` segments get `""`; `a=b=c` keeps `b=c`.
export query := (qs) ~> do {
  segs := str.split(qs, "&")
  while { xs: segs, acc: {} } {
    (xs, acc) ~> match xs {
      []: { out: acc },
      [s, ...t]: if str.is_empty(s) {
        { state: { xs: t, acc: acc } }
      } else {
        do {
          i := str.find(s, "=")
          if i < 0 {
            { state: { xs: t, acc: qput(acc, pct_decode(s), "") } }
          } else {
            { state: { xs: t, acc: qput(acc,
              pct_decode(str.slice(s, 0, i)),
              pct_decode(str.slice(s, i + 1, str.length(s)))) } }
          }
        }
      }
    }
  }
}

-- ---------------------------------------------------------------------
-- v3 pattern compiler: optional groups, suffix vars, search constraints
-- ---------------------------------------------------------------------

OPT_MAX_DEPTH  := 4
OPT_MAX_GROUPS := 8

--- identifier chars for `:param`/`*name` names: ASCII alnum, '_' and '-'.
is_nname := (c) ~> (c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) || c == 95 || c == 45

--- longest `[A-Za-z0-9_-]` run starting at index `i`; "" when none.
scan_name := (s, i) ~> while { k: i, acc: "" } {
  (k, acc) ~> if k < str.length(s) && is_nname(char.code_point_at(s, k)) {
    { state: { k: k + 1, acc: acc + str.char_at(s, k) } }
  } else {
    { out: acc }
  }
}

flushlit := (toks, lit) ~> if str.is_empty(lit) {
  toks
} else {
  [...toks, { t: "lit", s: lit }]
}

--- tokenize the path part of a pattern (the `?query` suffix is split
--- off before this runs). `(` opens an optional group only when
--- followed by '/' or ')' (otherwise literal); `)` closes a group only
--- while one is open (otherwise literal); `*` is a splat only at a
--- segment start (otherwise literal); `:` always opens a `:param`.
tokenize := (s) ~> while { i: 0, n: str.length(s), toks: [],
  lit: "", ss: true, depth: 0 } {
  (i, n, toks, lit, ss, depth) ~> if i >= n {
    { out: flushlit(toks, lit) }
  } else {
    do {
      c := str.char_at(s, i)
      nx := if i + 1 < n { str.char_at(s, i + 1) } else { "" }
      if c == "/" {
        { state: { i: i + 1, n: n,
          toks: [...flushlit(toks, lit), { t: "slash" }],
          lit: "", ss: true, depth: depth } }
      } else {
        if c == "(" && (nx == "/" || nx == ")") {
          { state: { i: i + 1, n: n,
            toks: [...flushlit(toks, lit), { t: "lp" }],
            lit: "", ss: true, depth: depth + 1 } }
        } else {
          if c == ")" && depth > 0 {
            { state: { i: i + 1, n: n,
              toks: [...flushlit(toks, lit), { t: "rp" }],
              lit: "", ss: false, depth: depth - 1 } }
          } else {
            if c == ":" {
              do {
                nm := scan_name(s, i + 1)
                if str.is_empty(nm) {
                  error.raise("http-route: empty param name in pattern '" +
                    s + "'")
                } else {
                  { state: { i: i + 1 + str.length(nm), n: n,
                    toks: [...flushlit(toks, lit),
                      { t: "param", name: nm }],
                    lit: "", ss: false, depth: depth } }
                }
              }
            } else {
              if c == "*" && ss {
                do {
                  nm := scan_name(s, i + 1)
                  { state: { i: i + 1 + str.length(nm), n: n,
                    toks: [...flushlit(toks, lit),
                      { t: "star",
                        name: if str.is_empty(nm) { null } else { nm } }],
                    lit: "", ss: false, depth: depth } }
                }
              } else {
                { state: { i: i + 1, n: n, toks: toks, lit: lit + c,
                  ss: false, depth: depth } }
              }
            }
          }
        }
      }
    }
  }
}

--- append the pending segment to `items` when it has parts or a
--- trailing boundary (`bnd` = "after slash", i.e. a segment may be
--- legitimately empty).
emit_seg := (items, parts, bnd) ~> if alen(parts) > 0 || bnd {
  [...items, { k: "seg", parts: parts }]
} else {
  items
}

--- recursive-descent parser over tokens; returns
--- `{ items, i, bad }` where `i` is the token index just past this
--- list (past the closing ')' for inner lists) and `bad` marks a
--- splat that is not the last item of its list (the pattern then
--- never matches, mirroring the v2 rule).
parse_list := (self, toks, i0, inner, depth, src) ~> do {
  while { i: i0, items: [], parts: [], bnd: inner == false,
    bad: false } {
    (i, items, parts, bnd, bad) ~> if bad {
      { out: { items: [], i: i, bad: true } }
    } else {
      if i >= alen(toks) {
        if inner {
          error.raise("http-route: unbalanced '(' in pattern '" + src + "'")
        } else {
          { out: { items: emit_seg(items, parts, bnd), i: i,
            bad: false } }
        }
      } else {
        do {
          tok := toks[i]
          if tok.t == "slash" {
            { state: { i: i + 1, items: emit_seg(items, parts, bnd),
              parts: [], bnd: true, bad: false } }
          } else {
            if tok.t == "lit" {
              { state: { i: i + 1, items: items,
                parts: [...parts, { t: "lit", s: tok.s }],
                bnd: false, bad: false } }
            } else {
              if tok.t == "param" {
                do {
                  lp := if alen(parts) == 0 {
                    null
                  } else {
                    parts[alen(parts) - 1]
                  }
                  if lp != null && lp.t == "param" {
                    error.raise("http-route: adjacent params need a " +
                      "literal separator in '" + src + "'")
                  } else {
                    { state: { i: i + 1, items: items,
                      parts: [...parts, { t: "param", name: tok.name }],
                      bnd: false, bad: false } }
                  }
                }
              } else {
                if tok.t == "star" {
                  do {
                    nb := i + 1 < alen(toks) && toks[i + 1].t != "rp"
                    { state: { i: i + 1,
                      items: [...items, { k: "splat", name: tok.name }],
                      parts: [], bnd: false, bad: nb } }
                  }
                } else {
                  if tok.t == "lp" {
                    do {
                      if depth + 1 > OPT_MAX_DEPTH {
                        error.raise("http-route: optional groups nested " +
                          "too deep (max " +
                          type.to_string(OPT_MAX_DEPTH) + ") in '" + src +
                          "'")
                      } else {
                        do {
                          it1 := emit_seg(items, parts, bnd)
                          nxt := if i + 1 < alen(toks) {
                            toks[i + 1]
                          } else {
                            null
                          }
                          if nxt == null ||
                             (nxt.t != "slash" && nxt.t != "rp") {
                            error.raise("http-route: optional group must " +
                              "start with '/' in '" + src + "'")
                          } else {
                            if nxt.t == "rp" {
                              { state: { i: i + 2, items: it1, parts: [],
                                bnd: false, bad: false } }
                            } else {
                              do {
                                g := self(self, toks, i + 2, true,
                                  depth + 1, src)
                                if g.bad {
                                  { state: { i: g.i, items: [], parts: [],
                                    bnd: false, bad: true } }
                                } else {
                                  do {
                                    git := if alen(g.items) == 0 {
                                      it1
                                    } else {
                                      [...it1,
                                        { k: "group", items: g.items }]
                                    }
                                    if g.i < alen(toks) {
                                      nt := toks[g.i]
                                      if nt.t != "slash" &&
                                         nt.t != "rp" &&
                                         nt.t != "lp" {
                                        error.raise("http-route: " +
                                          "optional group must be " +
                                          "followed by '/' or end in '" +
                                          src + "'")
                                      } else {
                                        { state: { i: g.i, items: git,
                                          parts: [], bnd: false,
                                          bad: false } }
                                      }
                                    } else {
                                      { state: { i: g.i, items: git,
                                        parts: [], bnd: false,
                                        bad: false } }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  } else {
                    -- tok.t == "rp"
                    if inner {
                      { out: { items: emit_seg(items, parts, bnd),
                        i: i + 1, bad: false } }
                    } else {
                      error.raise("http-route: unbalanced ')' in pattern '" +
                        src + "'")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

--- total optional groups in `items` (nested included).
count_groups := (self, items) ~> while { xs: items, n: 0 } {
  (xs, n) ~> match xs {
    []: { out: n },
    [it, ...t]: { state: { xs: t, n: n + if it.k == "group" {
        1 + self(self, it.items)
      } else {
        0
      } } }
  }
}

nname_str := (s) ~> str.length(scan_name(s, 0)) == str.length(s)

--- true when segment `seg` uses v3 productions (anything but a plain
--- literal, a pure `:name` or a trailing `*name`/`*`).
seg_needs := (seg) ~> do {
  if str.is_empty(seg) {
    false
  } else {
    c0 := str.char_at(seg, 0)
    if c0 == ":" {
      r := str.slice(seg, 1, str.length(seg))
      str.is_empty(r) || nname_str(r) == false
    } else {
      if c0 == "*" {
        nname_str(str.slice(seg, 1, str.length(seg))) == false
      } else {
        str.find(seg, ":") >= 0 || str.find(seg, "*") >= 0
      }
    }
  }
}

--- true when the path part uses v3 grammar (parens or non-v2
--- segments); such patterns go through the compiled matcher.
needs_compile := (p) ~> do {
  if str.find(p, "(") >= 0 || str.find(p, ")") >= 0 {
    true
  } else {
    while { xs: str.split(p, "/"), found: false } {
      (xs, found) ~> match xs {
        []: { out: found },
        [s, ...t]: if found || seg_needs(s) {
          { out: true }
        } else {
          { state: { xs: t, found: found } }
        }
      }
    }
  }
}

--- per-item specificity score. Literal segment = 2, pure `:param` = 1,
--- mixed literal+param segment (suffix/prefix vars) = 1.5, optional
--- group present = 0.5, splat = 0 -- interleaved with the v2 scores
--- (literal 2 > param 1 > splat 0) so old and new patterns compare.
parts_score := (parts) ~> do {
  if alen(parts) == 0 {
    2
  } else {
    if alen(parts) == 1 {
      if parts[0].t == "param" {
        1
      } else {
        2
      }
    } else {
      do {
        all_lit := while { xs: parts, ok: true } {
          (xs, ok) ~> match xs {
            []: { out: ok },
            [p, ...t]: if p.t == "lit" {
              { state: { xs: t, ok: ok } }
            } else {
              { out: false }
            }
          }
        }
        if all_lit {
          2
        } else {
          1.5
        }
      }
    }
  }
}

item_score := (it) ~> if it.k == "seg" {
  parts_score(it.parts)
} else {
  if it.k == "splat" {
    0
  } else {
    0.5
  }
}

--- match one path segment against compiled `parts` from char `pos`;
--- returns the accumulated params record or null. A param followed by
--- a literal anchor captures greedily (longest first), so `:file.:ext`
--- on "a.b.zip" binds file="a.b", ext="zip".
match_parts := (self, parts, s, pos, params) ~> match parts {
  []: if pos == str.length(s) {
    params
  } else {
    null
  },
  [p, ...rest]: if p.t == "lit" {
    do {
      ll := str.length(p.s)
      if pos + ll <= str.length(s) &&
         str.slice(s, pos, pos + ll) == p.s {
        self(self, rest, s, pos + ll, params)
      } else {
        null
      }
    }
  } else {
    if alen(rest) == 0 {
      hash_map.set(params, p.name, str.slice(s, pos, str.length(s)))
    } else {
      while { e: str.length(s), out: null } {
        (e, out) ~> if e < pos {
          { out: out }
        } else {
          do {
            r := self(self, rest, s, e,
              hash_map.set(params, p.name, str.slice(s, pos, e)))
            if r == null {
              { state: { e: e - 1, out: null } }
            } else {
              { out: r }
            }
          }
        }
      }
    }
  }
}

--- every way to match `items` against `segs`; each result is
--- `{ params, left }` (`left` = unconsumed path segments). Optional
--- groups enumerate present-branch results before absent-branch ones,
--- so earlier groups win ambiguous binds. Branch count is bounded by
--- OPT_MAX_GROUPS (<= 8 -> <= 256 expansions).
match_all := (self, items, segs, params) ~> match items {
  []: [{ params: params, left: segs }],
  [it, ...rest]: if it.k == "seg" {
    match segs {
      []: [],
      [s, ...st]: do {
        adds := match_parts(match_parts, it.parts, s, 0, {})
        if adds == null {
          []
        } else {
          self(self, rest, st, hash_map.merge(params, adds))
        }
      }
    }
  } else {
    if it.k == "splat" {
      [{ params: if it.name == null {
          params
        } else {
          hash_map.set(params, it.name, str.join(segs, "/"))
        },
        left: [] }]
    } else {
      do {
        pres := self(self, it.items, segs, params)
        pcont := while { xs: pres, out: [] } {
          (xs, out) ~> match xs {
            []: { out: out },
            [p, ...t]: { state: { xs: t,
              out: cat(out, self(self, rest, p.left, p.params)) } }
          }
        }
        cat(pcont, self(self, rest, segs, params))
      }
    }
  }
}

--- first complete compiled match's params, or null.
compiled_match := (c, path) ~> do {
  if c.bad {
    null
  } else {
    do {
      rs := match_all(match_all, c.items, str.split(path, "/"), {})
      while { xs: rs, out: null } {
        (xs, out) ~> match xs {
          []: { out: out },
          [r, ...t]: if alen(r.left) == 0 {
            { out: r.params }
          } else {
            { state: { xs: t, out: out } }
          }
        }
      }
    }
  }
}

--- `?k=v&flag` suffix -> ordered list of `{k, v}` constraint pairs
--- (percent-decoded like `query/1`; bare keys get "").
parse_qcons := (qs) ~> do {
  if str.is_empty(qs) {
    []
  } else {
    while { xs: str.split(qs, "&"), out: [] } {
      (xs, out) ~> match xs {
        []: { out: out },
        [s, ...t]: if str.is_empty(s) {
          { state: { xs: t, out: out } }
        } else {
          do {
            i := str.find(s, "=")
            if i < 0 {
              { state: { xs: t,
                out: [...out, { k: pct_decode(s), v: "" }] } }
            } else {
              { state: { xs: t, out: [...out,
                { k: pct_decode(str.slice(s, 0, i)),
                  v: pct_decode(str.slice(s, i + 1, str.length(s))) }] } }
            }
          }
        }
      }
    }
  }
}

--- compile `pat` into `{ path, items, bad, use, constraints, score }`.
--- `use` is false for plain v1/v2 patterns (they keep the legacy
--- matcher + scorer); `constraints` always holds the `?k=v` pairs.
compile_pat := (pat) ~> do {
  qi := str.find(pat, "?")
  pp := if qi < 0 { pat } else { str.slice(pat, 0, qi) }
  qs := if qi < 0 { "" } else {
    str.slice(pat, qi + 1, str.length(pat))
  }
  res := parse_list(parse_list, tokenize(pp), 0, false, 0, pp)
  cg := count_groups(count_groups, res.items)
  if res.bad == false && cg > OPT_MAX_GROUPS {
    error.raise("http-route: too many optional groups in '" + pat +
      "' (max " + type.to_string(OPT_MAX_GROUPS) + ")")
  }
  { path: pp, items: res.items, bad: res.bad, use: needs_compile(pp),
    constraints: parse_qcons(qs), score: lmap(item_score, res.items) }
}

--- segment-wise match of `pattern` against `path`. Returns the params
--- record on match, null on mismatch. v1/v2 patterns use the legacy
--- matcher; v3 patterns (optional groups, suffix vars, parens) go
--- through the compiled bounded-state matcher. A `?k=v` suffix on the
--- pattern is a dispatch-time search constraint -- `match_path`
--- ignores it (it only sees the path).
export match_path := (pattern, path) ~> do {
  c := compile_pat(pattern)
  if c.use {
    compiled_match(c, path)
  } else {
    match_segs(str.split(c.path, "/"), str.split(path, "/"), {})
  }
}

-- ---------------------------------------------------------------------
-- route maps (v2)
-- ---------------------------------------------------------------------

METHODS := ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]

CONFIG_KEYS := ["path", "pattern", "method", "methods", "constraints"]

is_method_key := (k) ~> is_str(k) && mem(str.upper(k), METHODS)

is_config_key := (k) ~> mem(k, CONFIG_KEYS)

--- key segments that contribute to a derived path/name ("." and ""
--- are index markers, not segments).
clean_segs := (segs) ~> lfilter((s) ~> s != "." && s != "", segs)

derived_path := (segs) ~> do {
  cs := clean_segs(segs)
  if alen(cs) == 0 { "/" } else { "/" + str.join(cs, "/") }
}

derived_name := (segs) ~> do {
  cs := clean_segs(segs)
  if alen(cs) == 0 { "index" } else { str.join(cs, "/") }
}

--- explicit `path`/`pattern` wins; a missing leading "/" is added.
norm_path := (p) ~> if str.starts_with(p, "/") { p } else { "/" + p }

explicit_path := (v, fallback) ~> do {
  pp := hash_map.get_or(v, "path", hash_map.get_or(v, "pattern", null))
  if pp == null {
    fallback
  } else {
    if is_str(pp) {
      norm_path(pp)
    } else {
      error.raise("http-route: route 'path'/'pattern' must be a string")
    }
  }
}

--- normalize `method`/`methods` (string or list of strings) to a
--- list of uppercased method names; absent -> ["*"].
methods_of := (v) ~> do {
  norm := (mv) ~> if is_str(mv) {
    [str.upper(mv)]
  } else {
    if is_arr(mv) {
      lmap((m) ~> if is_str(m) {
        str.upper(m)
      } else {
        error.raise("http-route: method names must be strings")
      }, mv)
    } else {
      error.raise("http-route: 'method'/'methods' must be a string or list")
    }
  }
  if hash_map.has(v, "methods") {
    norm(hash_map.get_or(v, "methods", []))
  } else {
    if hash_map.has(v, "method") {
      norm(hash_map.get_or(v, "method", "*"))
    } else {
      ["*"]
    }
  }
}

--- normalize a `constraints` spec (record `{k: v}` or list of
--- `{k,v}`/`{key,value}`/`[k,v]` pairs) to a list of `{k, v}` pairs;
--- null when absent.
norm_cons := (v) ~> if v == null {
  null
} else {
  if is_obj(v) {
    lmap((k) ~> { k: k, v: hash_map.get_or(v, k, null) },
      hash_map.keys(v))
  } else {
    if is_arr(v) {
      lmap((p) ~> if is_obj(p) {
        { k: hash_map.get_or(p, "k",
            hash_map.get_or(p, "key", null)),
          v: hash_map.get_or(p, "v",
            hash_map.get_or(p, "value", null)) }
      } else {
        if is_arr(p) && alen(p) == 2 {
          { k: p[0], v: p[1] }
        } else {
          error.raise("http-route: 'constraints' entries must be " +
            "{k,v} pairs")
        }
      }, v)
    } else {
      error.raise("http-route: 'constraints' must be a record or " +
        "list of pairs")
    }
  }
}

--- true when `v` is a pure method map: at least one HTTP-method key
--- and no keys other than method names or leaf config keys.
is_method_map := (v) ~> do {
  ks := hash_map.keys(v)
  mks := lfilter((k) ~> is_method_key(k), ks)
  bad := lfilter((k) ~> is_method_key(k) == false && is_config_key(k) == false, ks)
  alen(mks) > 0 && alen(bad) == 0
}

--- leaf spec `{ method?, methods?, path?, pattern?, handler }` -> one
--- entry per method.
spec_entries := (v, segs) ~> do {
  h := hash_map.get_or(v, "handler", null)
  chk := if is_arrow(h) { true } else {
    error.raise("http-route: route 'handler' must be an arrow")
  }
  path := explicit_path(v, derived_path(segs))
  nm := derived_name(segs)
  cons := norm_cons(hash_map.get_or(v, "constraints", null))
  lmap((m) ~> do {
    e := { name: nm, method: m, path: path, handler: h }
    if cons == null { e } else { hash_map.set(e, "constraints", cons) }
  }, methods_of(v))
}

--- method map `{ get: h, post: h, ... }` -> one entry per method key.
mmap_entries := (v, segs) ~> do {
  path := explicit_path(v, derived_path(segs))
  nm := derived_name(segs)
  cons := norm_cons(hash_map.get_or(v, "constraints", null))
  while { xs: hash_map.keys(v), out: [] } {
    (xs, out) ~> match xs {
      []: { out: out },
      [k, ...t]: if is_method_key(k) {
        do {
          h := hash_map.get_or(v, k, null)
          if is_arrow(h) == false {
            error.raise("http-route: method '" + k +
              "' leaf must be an arrow")
          } else {
            do {
              e := { name: nm, method: str.upper(k), path: path,
                handler: h }
              e2 := if cons == null { e } else {
                hash_map.set(e, "constraints", cons)
              }
              { state: { xs: t, out: [...out, e2] } }
            }
          }
        }
      } else {
        { state: { xs: t, out: out } }
      }
    }
  }
}

--- recursive route-map walker; `self` is passed explicitly because
--- self-recursive `:=` closures are not supported by the engines.
--- `v` is a leaf or nested map; `segs` is the accumulated key path.
walk := (self, v, segs) ~> do {
  if is_arrow(v) {
    [{ name: derived_name(segs), method: "*",
       path: derived_path(segs), handler: v }]
  } else {
    if is_obj(v) == false {
      error.raise("http-route: route leaf must be an arrow or record (got " +
        type.of(v) + ")")
    } else {
      if hash_map.has(v, "handler") {
        spec_entries(v, segs)
      } else {
        if is_method_map(v) {
          mmap_entries(v, segs)
        } else {
          while { xs: hash_map.keys(v), out: [] } {
            (xs, out) ~> match xs {
              []: { out: out },
              [k, ...t]: do {
                sub := hash_map.get_or(v, k, null)
                nsegs := if k == "." || k == "" {
                  segs
                } else {
                  [...segs, k]
                }
                ents := self(self, sub, nsegs)
                { state: { xs: t, out: cat(out, ents) } }
              }
            }
          }
        }
      }
    }
  }
}

--- flatten a route map into `{ entries, by_name }`; `by_name` keeps the
--- first entry per name.
build := (m) ~> do {
  ents := walk(walk, m, [])
  by := while { xs: ents, acc: {} } {
    (xs, acc) ~> match xs {
      []: { out: acc },
      [e, ...t]: { state: { xs: t,
        acc: if hash_map.has(acc, e.name) {
          acc
        } else {
          hash_map.set(acc, e.name, e)
        } } }
    }
  }
  { entries: ents, by_name: by }
}

--- normalize dispatch input: legacy entry list, route-map record
--- (`{entries, by_name}`) or a raw route map.
entries_of := (routes) ~> do {
  if is_arr(routes) {
    routes
  } else {
    if is_obj(routes) &&
       is_arr(hash_map.get_or(routes, "entries", null)) {
      hash_map.get_or(routes, "entries", [])
    } else {
      build(routes).entries
    }
  }
}

-- ---------------------------------------------------------------------
-- dispatch
-- ---------------------------------------------------------------------

--- route method check: absent or "*" matches anything, else exact
--- (case-sensitive -- HTTP methods are uppercase by convention).
method_ok := (r, m) ~> do {
  rm := hash_map.get_or(r, "method", "*")
  rm == "*" || rm == m
}

--- every `{k, v}` search constraint holds against the request's
--- parsed query record `qps`: key `k` must be present with value `v`
--- (string comparison; a repeated query key yields a list and never
--- equals a scalar constraint).
cons_ok := (cons, qps) ~> while { xs: cons, ok: true } {
  (xs, ok) ~> match xs {
    []: { out: ok },
    [p, ...t]: do {
      qv := hash_map.get_or(qps, p.k, null)
      if qv == null || str_of(qv) != str_of(p.v) {
        { out: false }
      } else {
        { state: { xs: t, ok: ok } }
      }
    }
  }
}

--- every entry whose path pattern (and search constraints) match,
--- as `{ route, params, score }` candidates in list order.
collect := (routes, p, qps) ~> while { xs: routes, out: [] } {
  (xs, out) ~> match xs {
    []: { out: out },
    [r, ...t]: do {
      pat := hash_map.get_or(r, "path",
        hash_map.get_or(r, "pattern", null))
      if pat == null || is_str(pat) == false {
        { state: { xs: t, out: out } }
      } else {
        do {
          comp := hash_map.get_or(r, "compiled", null)
          prm := if comp != null {
            compiled_match(comp, p)
          } else {
            match_path(pat, p)
          }
          if prm == null ||
             cons_ok(hash_map.get_or(r, "constraints", []), qps) == false {
            { state: { xs: t, out: out } }
          } else {
            { state: { xs: t, out: cat(out, [
              { route: r, params: prm,
                score: if comp != null {
                  comp.score
                } else {
                  pat_score(pat)
                } }]) } }
          }
        }
      }
    }
  }
}

--- highest-specificity candidate; equal scores keep list order.
pick_best := (cs) ~> while { xs: cs, best: null } {
  (xs, best) ~> match xs {
    []: { out: best },
    [c, ...t]: if best == null {
      { state: { xs: t, best: c } }
    } else {
      { state: { xs: t,
        best: if score_better(c.score, best.score) { c } else { best } } }
    }
  }
}

--- distinct methods of path-matching candidates, in encounter order.
allow_methods := (cands) ~> while { xs: cands, acc: [] } {
  (xs, acc) ~> match xs {
    []: { out: acc },
    [c, ...t]: do {
      m := hash_map.get_or(c.route, "method", "*")
      if mem(m, acc) {
        { state: { xs: t, acc: acc } }
      } else {
        { state: { xs: t, acc: [...acc, m] } }
      }
    }
  }
}

--- the 405 response: `Allow` lists the methods of the entries whose
--- path matched (comma-joined -- the wire codec wants a string).
method_not_allowed := (cands) ~> do {
  ms := allow_methods(cands)
  { status: 405,
    headers: { allow: str.join(ms, ", ") },
    body: "method not allowed" }
}

--- the default miss response (plain text, like serve-epoll's 400s).
export not_found := { status: 404, body: "not found" }

--- dispatch `req` through normalized entry list `es`.
dispatch_list := (es, req) ~> do {
  m := hash_map.get_or(req, "method", "")
  p := hash_map.get_or(req, "path", "")
  qps := query(hash_map.get_or(req, "query", ""))
  cands := collect(es, p, qps)
  mc := lfilter((c) ~> method_ok(c.route, m), cands)
  if alen(mc) == 0 {
    if alen(cands) == 0 {
      not_found
    } else {
      method_not_allowed(cands)
    }
  } else {
    do {
      best := pick_best(mc)
      h := hash_map.get_or(best.route, "handler", null)
      if is_arrow(h) == false {
        error.raise("http-route: matched route has no arrow handler")
      } else {
        do {
          req2 := hash_map.merge(req, {
            params: best.params,
            query_params: qps
          })
          h(req2)
        }
      }
    }
  }
}

--- compile one entry's path pattern once (v3 grammar): v3 patterns
--- get a `compiled` record `{ items, bad, score }` for the bounded-state
--- matcher, and `?k=v` search constraints merge into `entry.constraints`
--- (appended after any leaf-level `constraints`).
mark_one := (e) ~> do {
  pat := hash_map.get_or(e, "path",
    hash_map.get_or(e, "pattern", null))
  if pat == null || is_str(pat) == false {
    e
  } else {
    do {
      c := compile_pat(pat)
      e1 := if alen(c.constraints) > 0 {
        hash_map.set(e, "constraints",
          cat(hash_map.get_or(e, "constraints", []), c.constraints))
      } else {
        e
      }
      if c.use {
        hash_map.set(e1, "compiled",
          { items: c.items, bad: c.bad, score: c.score })
      } else {
        e1
      }
    }
  }
}

mark_entries := (es) ~> lmap(mark_one, es)

--- arity 1: build a route-map record from `{ name: leaf|nested }`
--- (a legacy entry list passes through as `{ entries, by_name: {} }`).
--- arity 2: dispatch `req` through `routes` (list, route-map record or
--- raw map) -- most-specific method+path match wins; path match with no
--- method match -> 405; no path match -> `not_found`.
export route := (a, ...rest) ~> do {
  if alen(rest) == 0 {
    if is_arr(a) {
      { entries: a, by_name: {} }
    } else {
      build(a)
    }
  } else {
    dispatch_list(mark_entries(entries_of(a)), rest[0])
  }
}

--- serve-ready handler: `serve(router(routes), { port })`. `routes` may
--- be a legacy entry list, a route-map record or a raw route map (built
--- and compiled once here, not per request).
export router := (routes) ~> do {
  es := mark_entries(entries_of(routes))
  (req) ~> dispatch_list(es, req)
}

-- ---------------------------------------------------------------------
-- href -- reverse URL generation
-- ---------------------------------------------------------------------

--- substitute one pattern segment; `pat` is only for the error message.
subst_seg := (s, params, pat) ~> do {
  if s == "" {
    ""
  } else {
    if str.starts_with(s, ":") {
      do {
        k := str.slice(s, 1, str.length(s))
        v := hash_map.get_or(params, k, null)
        if v == null {
          error.raise("http-route: href missing param '" + k +
            "' for '" + pat + "'")
        } else {
          str_of(v)
        }
      }
    } else {
      if str.starts_with(s, "*") {
        do {
          if s == "*" {
            str_of(hash_map.get_or(params, "*", ""))
          } else {
            do {
              k := str.slice(s, 1, str.length(s))
              v := hash_map.get_or(params, k, null)
              if v == null {
                error.raise("http-route: href missing param '" + k +
                  "' for '" + pat + "'")
              } else {
                str_of(v)
              }
            }
          }
        }
      } else {
        s
      }
    }
  }
}

--- render one compiled segment's `parts` (literals + `:param`s).
seg_str := (parts, params, pat) ~> while { xs: parts, acc: "" } {
  (xs, acc) ~> match xs {
    []: { out: acc },
    [p, ...t]: do {
      piece := if p.t == "lit" {
        p.s
      } else {
        do {
          v := hash_map.get_or(params, p.name, null)
          if v == null {
            error.raise("http-route: href missing param '" + p.name +
              "' for '" + pat + "'")
          } else {
            str_of(v)
          }
        }
      }
      { state: { xs: t, acc: acc + piece } }
    }
  }
}

--- render a compiled splat item (`*name` binds `name`, bare `*` reads
--- the `"*"` params key and defaults to "").
splat_str := (it, params, pat) ~> do {
  if it.name == null {
    str_of(hash_map.get_or(params, "*", ""))
  } else {
    do {
      v := hash_map.get_or(params, it.name, null)
      if v == null {
        error.raise("http-route: href missing param '" + it.name +
          "' for '" + pat + "'")
      } else {
        str_of(v)
      }
    }
  }
}

--- param/splat names referenced by one item (for optional groups).
part_names := (parts, acc) ~> while { xs: parts, out: acc } {
  (xs, out) ~> match xs {
    []: { out: out },
    [p, ...t]: { state: { xs: t,
      out: if p.t == "param" { [...out, p.name] } else { out } } }
  }
}

collect_names := (self, items, acc) ~> do {
  one := (it, a) ~> if it.k == "seg" {
    part_names(it.parts, a)
  } else {
    if it.k == "splat" {
      [...a, if it.name == null { "*" } else { it.name }]
    } else {
      self(self, it.items, a)
    }
  }
  while { xs: items, out: acc } {
    (xs, out) ~> match xs {
      []: { out: out },
      [it, ...t]: { state: { xs: t, out: one(it, out) } }
    }
  }
}

--- an optional group is emitted iff every param/splat it references
--- is present (non-null) in `params`; literal-only groups always emit.
group_needed := (items, params) ~> do {
  ns := collect_names(collect_names, items, [])
  while { xs: ns, ok: true } {
    (xs, ok) ~> match xs {
      []: { out: ok },
      [n, ...t]: if hash_map.get_or(params, n, null) == null {
        { out: false }
      } else {
        { state: { xs: t, ok: ok } }
      }
    }
  }
}

--- fold compiled `items` into a path body (no forced leading slash;
--- the first emitted piece supplies it). `acc` stays null until the
--- first item emits so leading empty segments still produce "/".
emit_body := (self, items, params, pat) ~> while { xs: items,
  acc: null } {
  (xs, acc) ~> match xs {
    []: { out: acc },
    [it, ...t]: if it.k == "seg" {
      do {
        s := seg_str(it.parts, params, pat)
        { state: { xs: t,
          acc: if acc == null { s } else { acc + "/" + s } } }
      }
    } else {
      if it.k == "splat" {
        do {
          s := splat_str(it, params, pat)
          { state: { xs: t,
            acc: if acc == null { s } else { acc + "/" + s } } }
        }
      } else {
        if group_needed(it.items, params) {
          do {
            inner := self(self, it.items, params, pat)
            { state: { xs: t, acc: if acc == null {
                inner
              } else {
                acc + "/" + inner
              } } }
          }
        } else {
          { state: { xs: t, acc: acc } }
        }
      }
    }
  }
}

emit_items := (items, params, pat) ~> do {
  b := emit_body(emit_body, items, params, pat)
  if b == null || str.is_empty(b) {
    "/"
  } else {
    b
  }
}

cons_str := (p) ~> p.k + "=" + str_of(p.v)

--- the `{pat, cons}` pair out of a string | entry record | spec record.
href_target := (a) ~> do {
  if is_str(a) {
    { pat: a, cons: [] }
  } else {
    if is_obj(a) {
      { pat: hash_map.get_or(a, "path",
          hash_map.get_or(a, "pattern", null)),
        cons: hash_map.get_or(a, "constraints", []) }
    } else {
      error.raise("http-route: href target must be a pattern string or route record")
    }
  }
}

href_pat := (pat, params, extra) ~> do {
  if is_str(pat) == false || pat == null {
    error.raise("http-route: href target has no path pattern")
  } else {
    do {
      if is_obj(params) == false {
        error.raise("http-route: href params must be a record")
      } else {
        do {
          c := compile_pat(pat)
          base := if c.use {
            emit_items(c.items, params, pat)
          } else {
            str.join(lmap((s) ~> subst_seg(s, params, pat),
              str.split(c.path, "/")), "/")
          }
          cons := cat(c.constraints, extra)
          if alen(cons) == 0 {
            base
          } else {
            base + "?" + str.join(lmap(cons_str, cons), "&")
          }
        }
      }
    }
  }
}

--- `by_name` lookup on a route-map record, building raw maps first.
lookup_name := (m, name) ~> do {
  bm := if is_obj(m) && hash_map.has(m, "by_name") {
    m
  } else {
    build(m)
  }
  e := hash_map.get_or(bm.by_name, name, null)
  if e == null {
    error.raise("http-route: no route named '" + name + "'")
  } else {
    e
  }
}

href_entry := (e, params) ~> href_pat(
  hash_map.get_or(e, "path", hash_map.get_or(e, "pattern", null)),
  params, hash_map.get_or(e, "constraints", []))

href2 := (a, b) ~> do {
  if is_obj(a) && hash_map.has(a, "by_name") && is_str(b) {
    href_entry(lookup_name(a, b), {})
  } else {
    do {
      t := href_target(a)
      href_pat(t.pat, b, t.cons)
    }
  }
}

--- `href(pattern|entry, params)` or `href(map, name, params)`.
export href := (a, ...rest) ~> do {
  if alen(rest) == 2 {
    href_entry(lookup_name(a, rest[0]), rest[1])
  } else {
    if alen(rest) == 1 {
      href2(a, rest[0])
    } else {
      error.raise("http-route: href expects (pattern, params) or (map, name, params)")
    }
  }
}

-- ---------------------------------------------------------------------
-- form -- remix GET+POST pair at one URL
-- ---------------------------------------------------------------------

--- `form(pattern)` returns `(handlers) ~> { path: pattern, ...hs }` --
--- a method-map leaf pairing e.g. `get`/`post` at the same URL.
--- `form(pattern, hs)` merges immediately. `hs` keys are method names
--- (any case) mapped to handler arrows.
export form := (pattern, ...rest) ~> do {
  if alen(rest) > 0 {
    hash_map.merge({ path: pattern }, rest[0])
  } else {
    (hs) ~> hash_map.merge({ path: pattern }, hs)
  }
}

-- ---------------------------------------------------------------------
-- resources -- REST route-map fragments
-- ---------------------------------------------------------------------

--- canonical actions, in declaration order. `new`/`edit` are GET pages;
--- `update` defaults to PUT+PATCH (HTML-form reality).
RES_ACTIONS := ["index", "show", "new", "create", "edit", "update",
  "destroy"]

--- actions a singular `resource` emits (no `:param` segment).
RES_SINGULAR := ["show", "create", "update", "destroy"]

--- per-action defaults: `methods` (overridable via `opts.methods`),
--- `id` = carries the `:param` segment (plural only), `suffix` =
--- literal tail appended after the param.
RES_DEFM := {
  index:   { methods: ["GET"],          id: false },
  show:    { methods: ["GET"],          id: true },
  new:     { methods: ["GET"],          id: false, suffix: "/new" },
  create:  { methods: ["POST"],         id: false },
  edit:    { methods: ["GET"],          id: true,  suffix: "/edit" },
  update:  { methods: ["PUT", "PATCH"], id: true },
  destroy: { methods: ["DELETE"],       id: true }
}

res_methods := (mv) ~> if is_str(mv) {
  [str.upper(mv)]
} else {
  if is_arr(mv) {
    lmap((m) ~> if is_str(m) {
      str.upper(m)
    } else {
      error.raise("http-route: resource 'methods' entries must be " +
        "strings")
    }, mv)
  } else {
    error.raise("http-route: resource 'methods' must be a string " +
      "or list")
  }
}

--- action path: `base` + optional `/:param` + optional literal suffix.
res_path := (base, param, action, plural) ~> do {
  d := hash_map.get_or(RES_DEFM, action, null)
  p := if plural && hash_map.get_or(d, "id", false) {
    base + "/:" + param
  } else {
    base
  }
  p + hash_map.get_or(d, "suffix", "")
}

--- first key of `h` not in `appl`, or null.
res_bad_key := (h, appl) ~> while { xs: hash_map.keys(h), bad: null } {
  (xs, bad) ~> match xs {
    []: { out: bad },
    [k, ...t]: if mem(k, appl) {
      { state: { xs: t, bad: bad } }
    } else {
      { out: k }
    }
  }
}

--- `only`/`except` option -> filtered action list (order of `appl`).
res_sel := (opts, appl) ~> do {
  only := hash_map.get_or(opts, "only", null)
  except := hash_map.get_or(opts, "except", null)
  chk := (v, what) ~> if v == null {
    true
  } else {
    if is_arr(v) == false {
      error.raise("http-route: resource '" + what +
        "' must be a list of action names")
    } else {
      while { ys: v, ok: true } {
        (ys, ok) ~> match ys {
          []: { out: ok },
          [a, ...t]: if is_str(a) && mem(a, appl) {
            { state: { ys: t, ok: ok } }
          } else {
            { out: false }
          }
        }
      }
    }
  }
  o := chk(only, "only")
  e := chk(except, "except")
  if o == false {
    error.raise("http-route: resource 'only' entries must be known " +
      "actions")
  } else {
    if e == false {
      error.raise("http-route: resource 'except' entries must be " +
        "known actions")
    } else {
      lfilter((a) ~> do {
        io := if only == null { true } else { mem(a, only) }
        ie := if except == null { false } else { mem(a, except) }
        io && ie == false
      }, appl)
    }
  }
}

--- build the fragment record `{ action: { methods, path, handler } }`.
res_build := (plural, name, handlers, opts) ~> do {
  if is_str(name) == false || str.is_empty(name) {
    error.raise("http-route: resource name must be a non-empty string")
  } else {
    if is_obj(opts) == false {
      error.raise("http-route: resource options must be a record")
    } else {
      do {
        appl := if plural { RES_ACTIONS } else { RES_SINGULAR }
        hmap := if is_arrow(handlers) {
          null
        } else {
          if is_obj(handlers) == false {
            error.raise("http-route: resource handlers must be an " +
              "arrow or a record of action arrows")
          } else {
            do {
              bk := res_bad_key(handlers, appl)
              if bk != null {
                error.raise("http-route: unknown resource action '" +
                  bk + "'")
              } else {
                handlers
              }
            }
          }
        }
        base := norm_path(hash_map.get_or(opts, "path", "/" + name))
        param := hash_map.get_or(opts, "param", "id")
        if is_str(param) == false || str.is_empty(param) {
          error.raise("http-route: resource 'param' must be a " +
            "non-empty string")
        } else {
          do {
            sel := res_sel(opts, appl)
            mopt := hash_map.get_or(opts, "methods", null)
            if mopt != null && is_obj(mopt) == false {
              error.raise("http-route: resource 'methods' must be a " +
                "record of action -> method(s)")
            } else {
              while { xs: sel, out: {} } {
                (xs, out) ~> match xs {
                  []: { out: out },
                  [a, ...t]: do {
                    h := if hmap == null {
                      handlers
                    } else {
                      hash_map.get_or(hmap, a, null)
                    }
                    if h == null {
                      { state: { xs: t, out: out } }
                    } else {
                      if is_arrow(h) == false {
                        error.raise("http-route: resource action '" + a +
                          "' must be an arrow")
                      } else {
                        do {
                          ms := if mopt != null &&
                                hash_map.has(mopt, a) {
                            res_methods(hash_map.get_or(mopt, a, null))
                          } else {
                            hash_map.get_or(
                              hash_map.get_or(RES_DEFM, a, {}),
                              "methods", [])
                          }
                          { state: { xs: t, out: hash_map.set(out, a,
                            { methods: ms,
                              path: res_path(base, param, a, plural),
                              handler: h }) } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

--- `resources(name, handlers, opts?)` -- plural REST fragment: expands
--- to `index`/`show`/`new`/`create`/`edit`/`update`/`destroy` spec
--- leaves under `/<name>` (`update` = PUT+PATCH). Merge into a route
--- map: `route({ photos: resources("photos", hs) })`.
export resources := (name, handlers, ...rest) ~> do {
  opts := if alen(rest) == 0 { {} } else { rest[0] }
  res_build(true, name, handlers, opts)
}

--- `resource(name, handlers, opts?)` -- singular variant: only
--- `show`/`create`/`update`/`destroy`, all at `/<name>` (no `:param`).
export resource := (name, handlers, ...rest) ~> do {
  opts := if alen(rest) == 0 { {} } else { rest[0] }
  res_build(false, name, handlers, opts)
}

-- ---------------------------------------------------------------------
-- JSON bodies
-- ---------------------------------------------------------------------

--- parse `req.body` as JSON; null when the body is absent/empty.
--- Malformed JSON propagates json.parse's error -- check the
--- content-type header (or use this only on routes that expect JSON).
export json_body := (req) ~> do {
  b := hash_map.get_or(req, "body", "")
  if typeof.is(b, typeof.str()) && str.is_empty(b) == false {
    json.parse(b)
  } else {
    null
  }
}
