admin_map := rt.route({ photos: admin_frag })

test_res_path_prefix := assert rt.router(admin_map)(
  mkreq("GET", "/admin/photos/5")) = { status: 200, body: "show 5" }

test_res_path_no_mount := assert rt.router(admin_map)(
  mkreq("GET", "/photos/5")) = { status: 404, body: "not found" }

