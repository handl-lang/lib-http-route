       handler: get_h }
})

test_v3_href_leaf_cons := assert rt.href(cons_leaf_map, "s", {}) =
  "/c?q=yes"

-- ---------------------------------------------------------------------
-- v3 differential: compiled matcher vs naive reference
-- ---------------------------------------------------------------------

tlen := (xs) ~> while { ys: xs, n: 0 } {
  (ys, n) ~> match ys {
    []: { out: n },
    [_h, ...t]: { state: { ys: t, n: n + 1 } }
  }
}

ref_nname := (c) ~> (c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) || c == 95 || c == 45

ref_name := (s, i) ~> while { k: i, acc: "" } {
  (k, acc) ~> if k < str.length(s) &&
               ref_nname(char.code_point_at(s, k)) {
    { state: { k: k + 1, acc: acc + str.char_at(s, k) } }
  } else {
    { out: acc }
  }
}

--- independent segment scanner: literals + `:param` parts.
ref_parts := (seg) ~> while { i: 0, n: str.length(seg), acc: [],
  lit: "" } {
  (i, n, acc, lit) ~> if i >= n {
    { out: if str.is_empty(lit) {
        acc
      } else {
        [...acc, { t: "l", s: lit }]
      } }
  } else {
    do {
      c := str.char_at(seg, i)
      if c == ":" {
        do {
          nm := ref_name(seg, i + 1)
          pre := if str.is_empty(lit) {
            acc
          } else {
            [...acc, { t: "l", s: lit }]
          }
          { state: { i: i + 1 + str.length(nm), n: n,
            acc: [...pre, { t: "p", name: nm }], lit: "" } }
        }
      } else {
        { state: { i: i + 1, n: n, acc: acc, lit: lit + c } }
      }
    }
  }
}

--- independent part matcher (same greedy-longest convention).
ref_pm := (self, parts, s, pos, params) ~> match parts {
  []: if pos == str.length(s) {
    params
  } else {
    null
  },
  [p, ...rest]: if p.t == "l" {
    do {
      ll := str.length(p.s)
      if pos + ll <= str.length(s) &&
         str.slice(s, pos, pos + ll) == p.s {
        self(self, rest, s, pos + ll, params)
      } else {
        null
      }
    }
  } else {
    if tlen(rest) == 0 {
      hash_map.set(params, p.name, str.slice(s, pos, str.length(s)))
    } else {
      while { e: str.length(s), out: null } {
        (e, out) ~> if e < pos {
          { out: out }
        } else {
          do {
            r := self(self, rest, s, e,
              hash_map.set(params, p.name, str.slice(s, pos, e)))
            if r == null {
              { state: { e: e - 1, out: null } }
            } else {
              { out: r }
            }
          }
        }
      }
    }
  }
}

ref_seg := (pseg, s) ~> do {
  ps := ref_parts(pseg)
  if tlen(ps) == 0 {
    if s == "" { {} } else { null }
  } else {
    ref_pm(ref_pm, ps, s, 0, {})
  }
}

ref_segs := (self, ps, ss, params) ~> match ps {
  []: if tlen(ss) == 0 {
    params
  } else {
    null
  },
  [p, ...pt]: match ss {
    []: null,
    [s, ...st]: do {
      adds := ref_seg(p, s)
      if adds == null {
        null
      } else {
        self(self, pt, st, hash_map.merge(params, adds))
      }
    }
  }
}

--- first k / drop first k elements.
ref_take := (xs, k) ~> while { ys: xs, i: 0, out: [] } {
  (ys, i, out) ~> match ys {
    []: { out: out },
    [h, ...t]: if i < k {
      { state: { ys: t, i: i + 1, out: [...out, h] } }
    } else {
      { out: out }
    }
  }
}

ref_drop := (xs, k) ~> while { ys: xs, i: 0, out: [] } {
  (ys, i, out) ~> match ys {
    []: { out: out },
    [h, ...t]: if i < k {
      { state: { ys: t, i: i + 1, out: out } }
    } else {
      { state: { ys: t, i: i + 1, out: [...out, h] } }
    }
  }
}

--- match one group-free expanded pattern against `path`.
ref_match_one := (ep, path) ~> do {
  ps := str.split(ep, "/")
  ss := str.split(path, "/")
  n := tlen(ps)
  lp := ps[n - 1]
  if str.starts_with(lp, "*") {
    pre := ref_take(ps, n - 1)
    if tlen(ss) < n - 1 {
      null
    } else {
      do {
        r := ref_segs(ref_segs, pre, ref_take(ss, n - 1), {})
        if r == null {
          null
        } else {
          restj := str.join(ref_drop(ss, n - 1), "/")
          nm := str.slice(lp, 1, str.length(lp))
          if nm == "" {
            r
          } else {
            hash_map.set(r, nm, restj)
          }
        }
      }
    }
  } else {
    if tlen(ss) != n {
      null
    } else {
      ref_segs(ref_segs, ps, ss, {})
    }
  }
}

--- index of first group-opening '(' (next char '/' or ')'), -1 none.
ref_find_lp := (pat) ~> while { i: 0, n: str.length(pat) } {
  (i, n) ~> if i + 1 >= n {
    { out: -1 }
  } else {
    do {
      if str.char_at(pat, i) == "(" &&
         (str.char_at(pat, i + 1) == "/" ||
          str.char_at(pat, i + 1) == ")") {
        { out: i }
      } else {
        { state: { i: i + 1, n: n } }
      }
    }
  }
}

--- index of the ')' matching the '(' at `i`, -1 when unbalanced.
ref_close := (pat, i) ~> while { j: i, d: 0 } {
  (j, d) ~> if j >= str.length(pat) {
    { out: -1 }
  } else {
    do {
      c := str.char_at(pat, j)
      nd := if c == "(" {
        d + 1
      } else {
        if c == ")" { d - 1 } else { d }
      }
      if nd == 0 {
        { out: j }
      } else {
        { state: { j: j + 1, d: nd } }
      }
    }
  }
}

--- enumerate all optional-group expansions, present-branch first.
ref_expand := (self, pat) ~> do {
  gi := ref_find_lp(pat)
  if gi < 0 {
    [pat]
  } else {
    do {
      pe := ref_close(pat, gi)
      inner := str.slice(pat, gi + 1, pe)
      rest := str.slice(pat, pe + 1, str.length(pat))
      pre := str.slice(pat, 0, gi)
      [...self(self, pre + inner + rest),
       ...self(self, pre + rest)]
    }
  }
}

--- naive full-pattern matcher: expand groups, try each expansion.
ref_match := (pat, path) ~> do {
  qi := str.find(pat, "?")
  pp := if qi < 0 { pat } else { str.slice(pat, 0, qi) }
  exps := ref_expand(ref_expand, pp)
  while { xs: exps, out: null } {
    (xs, out) ~> match xs {
      []: { out: out },
      [e, ...t]: do {
        r := ref_match_one(e, path)
        if r == null {
          { state: { xs: t, out: null } }
        } else {
          { out: r }
        }
      }
    }
  }
}

diff_cases := [
  { p: "/files(/:name)", path: "/files" },
  { p: "/files(/:name)", path: "/files/x" },
  { p: "/files(/:name)", path: "/files/x/y" },
  { p: "/files(/:name)", path: "/other" },
  { p: "/files(/:name)", path: "/files/" },
  { p: "/a(/b(/c))", path: "/a" },
  { p: "/a(/b(/c))", path: "/a/b" },
  { p: "/a(/b(/c))", path: "/a/b/c" },
  { p: "/a(/b(/c))", path: "/a/c" },
  { p: "/a(/b)(/c)", path: "/a" },
  { p: "/a(/b)(/c)", path: "/a/b" },
  { p: "/a(/b)(/c)", path: "/a/c" },
  { p: "/a(/b)(/c)", path: "/a/b/c" },
  { p: "/a(/b)(/c)", path: "/a/b/c/d" },
  { p: "/dl/:file.:ext", path: "/dl/a.zip" },
  { p: "/dl/:file.:ext", path: "/dl/a.b.zip" },
  { p: "/dl/:file.:ext", path: "/dl/.zip" },
  { p: "/dl/:file.:ext", path: "/dl/a" },
  { p: "/dl/:file.:ext", path: "/dl/a.zip/x" },
  { p: "(/v:version)/status", path: "/status" },
  { p: "(/v:version)/status", path: "/v1/status" },
  { p: "(/v:version)/status", path: "/v1.2/status" },
  { p: "(/v:version)/status", path: "/x/status" },
  { p: "/files(/:dir)/*rest", path: "/files" },
  { p: "/files(/:dir)/*rest", path: "/files/a" },
  { p: "/files(/:dir)/*rest", path: "/files/a/b/c" },
  { p: "/files(/:dir)/*rest", path: "/files/" },
  { p: "/x(/:a)/y(/:b)", path: "/x/y" },
  { p: "/x(/:a)/y(/:b)", path: "/x/1/y" },
  { p: "/x(/:a)/y(/:b)", path: "/x/1/y/2" },
  { p: "/x(/:a)/y(/:b)", path: "/x/y/2" },
  { p: "/p/:x.:y(/:z)", path: "/p/1.2" },
  { p: "/p/:x.:y(/:z)", path: "/p/1.2/3" },
  { p: "/one(/two/three)", path: "/one" },
  { p: "/one(/two/three)", path: "/one/two/three" },
  { p: "/one(/two/three)", path: "/one/two" },
  { p: "/m/:a+:b", path: "/m/1+2" },
  { p: "/m/:a+:b", path: "/m/x+y+z" }
]

diff_ok := (cases) ~> while { xs: cases, ok: true } {
  (xs, ok) ~> match xs {
    []: { out: ok },
    [c, ...t]: do {
      got := rt.match_path(c.p, c.path)
      want := ref_match(c.p, c.path)
      if got == want {
        { state: { xs: t, ok: ok } }
      } else {
        { out: false }
      }
    }
  }
}

test_v3_diff_reference := assert diff_ok(diff_cases) = true

-- ---------------------------------------------------------------------
-- v3: resources / resource REST fragments (P-006)
-- ---------------------------------------------------------------------

idx_h := (_r) ~> do { { status: 200, body: "index" } }
show_h := (r) ~> do { { status: 200, body: "show " + r.params.id } }
newpage_h := (_r) ~> do { { status: 200, body: "newpage" } }
create_h := (_r) ~> do { { status: 200, body: "create" } }
edit_h := (_r) ~> do { { status: 200, body: "edit" } }
upd_h := (r) ~> do { { status: 200, body: "upd " + r.method } }
del_h := (_r) ~> do { { status: 204, body: "" } }

photos_h := {
  index: idx_h, show: show_h, new: newpage_h, create: create_h,
  edit: edit_h, update: upd_h, destroy: del_h
}

photos_frag := rt.resources("photos", photos_h)
photos_map := rt.route({ photos: photos_frag, health: health_h })

test_res_frag_show_path := assert photos_frag.show.path = "/photos/:id"

test_res_frag_update_methods := assert photos_frag.update.methods =
  ["PUT", "PATCH"]

test_res_index := assert rt.router(photos_map)(mkreq("GET", "/photos")) =
  { status: 200, body: "index" }

test_res_show := assert rt.router(photos_map)(mkreq("GET", "/photos/7")) =
  { status: 200, body: "show 7" }

test_res_new := assert rt.router(photos_map)(mkreq("GET", "/photos/new")) =
  { status: 200, body: "newpage" }

test_res_create := assert rt.router(photos_map)(mkreq("POST", "/photos")) =
  { status: 200, body: "create" }

test_res_edit := assert rt.router(photos_map)(
  mkreq("GET", "/photos/7/edit")) = { status: 200, body: "edit" }

test_res_update_put := assert rt.router(photos_map)(
  mkreq("PUT", "/photos/7")) = { status: 200, body: "upd PUT" }

test_res_update_patch := assert rt.router(photos_map)(
  mkreq("PATCH", "/photos/7")) = { status: 200, body: "upd PATCH" }

test_res_destroy := assert rt.router(photos_map)(
  mkreq("DELETE", "/photos/7")) = { status: 204, body: "" }

test_res_merge_sibling := assert rt.router(photos_map)(
  mkreq("GET", "/health")) = { status: 200, body: "ok GET" }

test_res_href_show := assert rt.href(photos_frag.show, { id: "7" }) =
  "/photos/7"

test_res_href_named := assert rt.href(photos_map, "photos/show",
  { id: "3" }) = "/photos/3"

test_res_href_edit := assert rt.href(photos_map, "photos/edit",
  { id: "3" }) = "/photos/3/edit"

test_res_top_level := assert rt.router(rt.resources("photos",
  photos_h))(mkreq("GET", "/photos/4")) =
  { status: 200, body: "show 4" }

-- single arrow handler = all actions

anyres := rt.resources("things", get_h)

test_res_arrow_all := assert rt.router(rt.route({
  things: anyres }))(mkreq("DELETE", "/things/1")) =
  { status: 200, body: "GET" }

-- only / except

only_frag := rt.resources("photos", photos_h, { only: ["index", "show"] })
only_map := rt.route({ photos: only_frag })

test_res_only_index := assert rt.router(only_map)(
  mkreq("GET", "/photos")) = { status: 200, body: "index" }

test_res_only_show := assert rt.router(only_map)(
  mkreq("GET", "/photos/2")) = { status: 200, body: "show 2" }

test_res_only_no_create := assert rt.router(only_map)(
  mkreq("POST", "/photos")) =
  { status: 405, headers: { allow: "GET" },
    body: "method not allowed" }

except_frag := rt.resources("photos", photos_h, { except: ["destroy"] })
except_map := rt.route({ photos: except_frag })

test_res_except_destroy := assert rt.router(except_map)(
  mkreq("DELETE", "/photos/1")) =
  { status: 405, headers: { allow: "GET, PUT, PATCH" },
    body: "method not allowed" }

test_res_except_show_ok := assert rt.router(except_map)(
  mkreq("GET", "/photos/1")) = { status: 200, body: "show 1" }

-- param / path / methods options

slug_show_h := (r) ~> do {
  { status: 200, body: "show " + r.params.slug }
}

slug_frag := rt.resources("photos", { show: slug_show_h },
  { param: "slug" })
slug_map := rt.route({ photos: slug_frag })

test_res_param_path := assert slug_frag.show.path = "/photos/:slug"

test_res_param_match := assert rt.router(slug_map)(
